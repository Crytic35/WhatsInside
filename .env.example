# ==================================================
# WHAT'S INSIDE? - ENVIRONMENT CONFIGURATION
# ==================================================

# Ollama local inference endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Primary vision model (Gemma 4:12B)
OLLAMA_MODEL=gemma4:12b

# Ollama timeout in seconds for neural vision processing
OLLAMA_TIMEOUT_SECONDS=120.0

# Database URL (SQLite)
DATABASE_URL=sqlite:///./whats_inside.db

# Frontend API base URL (for Vite)
VITE_API_URL=http://localhost:8000
