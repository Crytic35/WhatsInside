# ==================================================
# WHAT'S INSIDE? - ENVIRONMENT CONFIGURATION
# ==================================================

# ── LOCAL DEVELOPMENT ─────────────────────────────

# Ollama local inference endpoint (only relevant when running locally)
OLLAMA_BASE_URL=http://localhost:11434

# Primary vision model (Gemma 4:12B) — local Ollama only
OLLAMA_MODEL=gemma4:12b

# Ollama timeout in seconds for neural vision processing
OLLAMA_TIMEOUT_SECONDS=120.0

# Database URL (SQLite) — local path; on Vercel /tmp is used automatically
DATABASE_URL=sqlite:///./whats_inside.db

# ── FRONTEND (Vite) ───────────────────────────────

# Local development: set to the FastAPI dev server URL.
# Vercel production: leave UNSET (empty) so the frontend uses relative /api/* paths
# that Vercel routes to the serverless function.
#
# VITE_API_URL=http://localhost:8000  # uncomment for local dev if proxy isn't used

